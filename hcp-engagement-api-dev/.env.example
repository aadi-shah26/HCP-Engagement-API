# Copy to .env and fill in real values. Never commit .env.

# Groq API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Signing secrets. Generate with:
# python3 -c "import secrets; print('SECRET_KEY=' + secrets.token_hex(32)); print('JWT_SECRET_KEY=' + secrets.token_hex(32))"
# If unset, the API uses random per-process secrets (all tokens reset on restart).
SECRET_KEY=
JWT_SECRET_KEY=

# Browser origins allowed to open the streaming WebSocket
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only for `python3 app.py` local runs; never enable in a shared environment
FLASK_DEBUG=false
